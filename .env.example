# Copia este archivo como .env y reemplaza los valores.
# La service role key va solo en el servidor local, nunca en el navegador.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY
SUPABASE_BUCKET=soportes-eps
SESSION_SECRET=CAMBIA_ESTO_POR_UN_TEXTO_LARGO_ALEATORIO

# 1 = al iniciar trae metadatos desde Supabase y sincroniza datos locales.
SUPABASE_PULL_ON_START=1

# 1 = despues de cargar/editar/descargar sincroniza automaticamente.
SUPABASE_SYNC_ON_WRITE=1

# supabase = usa Supabase como base unica. sqlite queda desactivado.
DATA_BACKEND=supabase
